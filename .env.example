# ============================================================
# Shared (Node server + Python agents)
# ============================================================
# MongoDB connection. Both server (Mongoose) and agents (PyMongo) connect to
# this. The database name is pinned to `matcha` in code, so the URI does not
# need a path component.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# ============================================================
# Node server (server/index.js)
# ============================================================
# Port for the Express API. Default: 3001.
PORT=3001

# ============================================================
# Python agents (agents/server.py)
# ============================================================
# Port for the FastAPI agent service. Default: 8000.
AGENT_PORT=8000

# One of the LLM keys is required for the negotiation + payment agents.
# Anthropic is preferred; OpenAI is used as a fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# x402 / Base blockchain settings — only required for real payment settlement.
# Leave blank to run the payment agent in simulation mode.
X402_WALLET_ADDRESS=
X402_PRIVATE_KEY=
X402_NETWORK=base-sepolia

# ============================================================
# Frontend (frontend/.env)
# ============================================================
# The frontend has its own .env file. Variables it uses:
#   VITE_API_BASE_URL    Base URL for the Node API, including /api suffix
#                        (default: http://localhost:3001/api)
#   VITE_AGENTS_BASE_URL Base URL for the Python agents service
#                        (default: http://localhost:8000)
#   VITE_ADVERTISER_ID   Optional default advertiser id for dev (else
#                        resolved via ?advertiserId=... or /api/advertisers/sample)
